# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# per-user file storage
/storage/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# eve
/.eve/
/.output/

# typescript
*.tsbuildinfo
next-env.d.ts

# kilo
.kilo/

# vendored claude-motion toolkit in the sandbox seed (generated at runtime)
agent/sandbox/workspace/**/node_modules/
agent/sandbox/workspace/out/
agent/sandbox/workspace/sims/dist/
agent/sandbox/workspace/public/*.wav
